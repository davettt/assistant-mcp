{
  "name": "@tiongcreative/assistant-mcp",
  "version": "0.4.0",
  "description": "MCP server that lets an AI assistant on your Mac use your Tiong Creative apps while they are open.",
  "type": "module",
  "bin": {
    "tiongcreative-assistant-mcp": "src/index.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "npm run test:unit && npm run test:integration",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security": "npm audit --audit-level=high --omit=dev",
    "sast": "semgrep scan --config auto --error --quiet --exclude-rule javascript.lang.security.audit.path-traversal.path-join-resolve-traversal.path-join-resolve-traversal --exclude-rule javascript.express.security.audit.express-path-join-resolve-traversal.express-path-join-resolve-traversal --exclude-rule javascript.express.security.audit.express-res-sendfile.express-res-sendfile --exclude-rule javascript.express.security.audit.remote-property-injection.remote-property-injection --exclude-rule html.security.audit.missing-integrity.missing-integrity",
    "secrets": "betterleaks git . --redact",
    "secrets:staged": "betterleaks git --staged --redact",
    "licenses": "license-checker --production --failOn 'GPL-2.0;GPL-3.0;AGPL-1.0;AGPL-3.0' --summary",
    "licenses:file": "license-checker --production --relativeLicensePath | sed -e \"s|$PWD/||g\" -e \"s|$PWD|.|g\" > THIRD-PARTY-LICENSES.txt",
    "deps:check": "node ../build-policy/scripts/check-allowlist.js .",
    "deps:verify": "node ../build-policy/scripts/verify-package.js",
    "review": "coderabbit review --agent --include-untracked",
    "prepare": "husky",
    "validate": "npm run lint && npm run format:check",
    "quality": "npm run validate && npm run sast && npm run security && npm run secrets && npm run licenses && npm run deps:check && npm run review",
    "test:unit": "node --test tests/dates.test.js tests/install.test.js tests/chatgpt-install.test.js",
    "test:integration": "node --test tests/due-again.test.js tests/gift-keeper.test.js tests/client-manager.test.js tests/lists-and-notes.test.js"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "eslint": "^9.27.0",
    "eslint-plugin-security": "^3.0.1",
    "husky": "^9.1.7",
    "license-checker": "^25.0.1",
    "prettier": "^3.5.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davettt/assistant-mcp.git"
  },
  "keywords": [
    "mcp",
    "claude",
    "tiongcreative",
    "due-again"
  ],
  "publishConfig": {
    "access": "public"
  }
}
